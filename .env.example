# Copy to .env.local for local development (`npm run dev`), and add the same
# variables in Cloudflare → Workers & Pages → thediadem → Settings → Variables and Secrets
# (type: Secret, for both Production and Preview).

# --- Server only (used by functions/api/contact.ts and functions/api/assistant.ts). Never prefix these with VITE_. ---
# GoHighLevel → Settings → Private Integrations → token with
# "View Contacts" and "Edit Contacts" scopes
GHL_API_TOKEN=
# Sub-account (location) ID, from the GoHighLevel URL: /v2/location/<ID>/...
GHL_LOCATION_ID=8WJ6nyFWjFzTgnujES0n
# Optional: extra comma-separated tags added to every website lead
# GHL_TAGS=website-lead
# Optional: calendar the "Crest" chat books free consultations into (Calendars →
# calendar settings → the ID in its URL). The token then also needs the "View Calendars"
# and "Edit Calendar Events" scopes. Without it, Crest saves a booking request with the
# visitor's preferred date and the team confirms the time.
# GHL_CALENDAR_ID=

# --- Server only (used by functions/api/assistant.ts, the "Crest" chat). Never prefix with VITE_. ---
# Anthropic API key: the assistant answers with Claude. It books consultations with the GHL_* values above.
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=

# --- Browser (optional) ---
# Override where the contact form posts. Defaults to /api/contact.
# VITE_CONTACT_ENDPOINT=
# Optional: override where the assistant posts. Defaults to /api/assistant (Claude).
# If that fails, it answers from the FAQs and services already on the site.
# VITE_ASSISTANT_ENDPOINT=
